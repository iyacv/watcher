{
  "title": "NYK-FIL Security Monitoring",
  "uid": "capstone-security",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "MySQL Source",
        "pluginId": "mysql",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "title": "Total Logs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT (SELECT COUNT(*) FROM vulnerabilities) + (SELECT COUNT(*) FROM events) AS value",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 2,
      "title": "Critical",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "dark-red", "value": 0 }] }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT SUM(cnt) AS value FROM (SELECT COUNT(*) cnt FROM vulnerabilities WHERE severity='critical' UNION ALL SELECT COUNT(*) FROM events WHERE severity='critical') t",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 3,
      "title": "High",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": 0 }] }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT SUM(cnt) AS value FROM (SELECT COUNT(*) cnt FROM vulnerabilities WHERE severity='high' UNION ALL SELECT COUNT(*) FROM events WHERE severity='high') t",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 4,
      "title": "Medium",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": 0 }] }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT SUM(cnt) AS value FROM (SELECT COUNT(*) cnt FROM vulnerabilities WHERE severity='medium' UNION ALL SELECT COUNT(*) FROM events WHERE severity='medium') t",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 5,
      "title": "Low",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT SUM(cnt) AS value FROM (SELECT COUNT(*) cnt FROM vulnerabilities WHERE severity='low' UNION ALL SELECT COUNT(*) FROM events WHERE severity='low') t",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 6,
      "title": "Top Recurring Issues (F5 Vulnerabilities)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT name AS 'Vulnerability', COUNT(*) AS 'count' FROM vulnerabilities GROUP BY name ORDER BY count DESC LIMIT 8",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 7,
      "title": "Top Recurring Events (Log360)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT event_type AS 'Event Type', COUNT(*) AS 'count' FROM events GROUP BY event_type ORDER BY count DESC LIMIT 8",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 8,
      "title": "Severity Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        }
      },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] },
          { "matcher": { "id": "byName", "options": "High" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "Medium" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Low" },      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Info" },     "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT SUM(CASE WHEN severity='critical' THEN 1 ELSE 0 END) AS 'Critical', SUM(CASE WHEN severity='high' THEN 1 ELSE 0 END) AS 'High', SUM(CASE WHEN severity='medium' THEN 1 ELSE 0 END) AS 'Medium', SUM(CASE WHEN severity='low' THEN 1 ELSE 0 END) AS 'Low', SUM(CASE WHEN severity='info' THEN 1 ELSE 0 END) AS 'Info' FROM vulnerabilities",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 9,
      "title": "Vulnerabilities Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT DATE(detected_at) AS time, COUNT(*) AS value FROM vulnerabilities WHERE $__timeFilter(detected_at) GROUP BY DATE(detected_at) ORDER BY time",
        "format": "time_series",
        "refId": "A"
      }]
    },

    {
      "id": 10,
      "title": "All Vulnerabilities",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT host AS 'Host', vuln_id AS 'CVE / ID', name AS 'Vulnerability', severity AS 'Severity', cvss AS 'CVSS', status AS 'Status', detected_at AS 'Detected' FROM vulnerabilities ORDER BY FIELD(severity,'critical','high','medium','low','info'), detected_at DESC LIMIT 200",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 11,
      "title": "Correlations — Possible Active Exploitation",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT host AS 'Host', vuln_id AS 'CVE / ID', event_type AS 'Suspicious Event', severity AS 'Severity', vuln_time AS 'Vuln Time', event_time AS 'Event Time', created_at AS 'Correlated At' FROM correlations ORDER BY created_at DESC LIMIT 100",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 12,
      "title": "Recent Log360 Events",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "datasource": { "type": "mysql", "uid": "${datasource}" },
      "targets": [{
        "datasource": { "type": "mysql", "uid": "${datasource}" },
        "rawSql": "SELECT host AS 'Host', event_id AS 'Event ID', event_type AS 'Event Type', severity AS 'Severity', user AS 'User', detected_at AS 'Detected', description AS 'Description' FROM events WHERE $__timeFilter(detected_at) ORDER BY FIELD(severity,'critical','high','medium','low','info'), detected_at DESC LIMIT 200",
        "format": "table",
        "refId": "A"
      }]
    }

  ]
}
